# Copie para deploy/production.env e substitua todos os valores de exemplo.
# Este arquivo real é ignorado pelo Git e nunca deve ser versionado.

PROD_POSTGRES_PASSWORD=troque-por-uma-senha-forte-e-exclusiva
# A senha na URL precisa ser igual a PROD_POSTGRES_PASSWORD.
PROD_DATABASE_URL=postgresql://flowops:troque-por-uma-senha-forte-e-exclusiva@postgres:5432/flowops?schema=public

# Gere valores diferentes com: openssl rand -hex 32
PROD_JWT_ACCESS_SECRET=troque-por-um-secret-aleatorio-com-pelo-menos-32-caracteres
PROD_JWT_REFRESH_SECRET=troque-por-outro-secret-aleatorio-com-pelo-menos-32-caracteres

# URLs públicas servidas pelo proxy reverso com HTTPS.
PROD_PUBLIC_API_URL=https://api.exemplo.com/api
PROD_CORS_ORIGIN=https://app.exemplo.com

# Portas locais para o proxy reverso do servidor alcançar.
PROD_API_PORT=4000
PROD_WEB_PORT=3000

# URLs usadas pelo smoke test local; não precisam ser públicas.
PROD_API_SMOKE_URL=http://127.0.0.1:4000/api
PROD_WEB_SMOKE_URL=http://127.0.0.1:3000

# Intervalo mínimo entre leituras do mesmo crachá no quiosque.
KIOSK_PUNCH_DEBOUNCE_SECONDS=5
