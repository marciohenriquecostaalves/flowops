{
  "name": "flowops",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @flowops/database prisma:generate",
    "db:migrate": "pnpm --filter @flowops/database prisma:migrate",
    "db:seed": "pnpm --filter @flowops/database prisma:seed",
    "db:studio": "pnpm --filter @flowops/database prisma:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6"
  }
}
