generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum ActivityStatus {
  ACTIVE
  INACTIVE
}

enum SessionStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProductionPunchType {
  START
  PAUSE
  RESUME
  FINISH
}

enum BusinessUnitType {
  HEADQUARTERS
  BRANCH
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  legalName   String?
  emailDomain String?
  usesOwnEmailDomain Boolean @default(false)
  supportEmail String?
  phone       String?
  city        String?
  state       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  employees   Employee[]
  departments Department[]
  activities  Activity[]
  sessions    ActivitySession[]
  auditLogs   AuditLog[]
  shifts      Shift[]
  jobTitles   JobTitle[]
  roles       Role[]
  kioskDevices KioskDevice[]
  productionPunches ProductionPunch[]
  businessUnits BusinessUnit[]
}

model User {
  id              String     @id @default(cuid())
  tenantId        String
  email           String
  passwordHash    String
  name            String
  status          UserStatus @default(ACTIVE)
  refreshTokenHash String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  accessAreas     String[]   @default([])
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles           UserRole[]
  employee        Employee?
  auditLogs       AuditLog[]
  unitAccess      UserUnitAccess[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model BusinessUnit {
  id               String           @id @default(cuid())
  tenantId         String
  parentId         String?
  code             String
  name             String
  type             BusinessUnitType @default(BRANCH)
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent           BusinessUnit?    @relation("BusinessUnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         BusinessUnit[]   @relation("BusinessUnitHierarchy")
  userAccess       UserUnitAccess[]
  employees        Employee[]
  departments      Department[]
  shifts           Shift[]
  activities       Activity[]
  sessions         ActivitySession[]
  kioskDevices     KioskDevice[]
  productionPunches ProductionPunch[]
  jobTitles        JobTitle[]
  auditLogs        AuditLog[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, active])
}

model UserUnitAccess {
  userId    String
  unitId    String
  isPrimary Boolean      @default(false)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit      BusinessUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@index([unitId])
}

model Role {
  id          String       @id @default(cuid())
  name        String
  description String?
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
}

model Permission {
  id          String       @id @default(cuid())
  key         String       @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Employee {
  id           String         @id @default(cuid())
  tenantId     String
  unitId       String?
  userId       String?        @unique
  employeeCode String
  name         String
  email        String?
  corporateEmail Boolean   @default(false)
  jobTitle     String?
  jobTitleId   String?
  photoData    String?
  badgeCode    String?
  status       EmployeeStatus @default(ACTIVE)
  departmentId String?
  shiftId      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         BusinessUnit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  shift        Shift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  jobTitleRef  JobTitle?      @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  sessions     ActivitySession[]
  productionPunches ProductionPunch[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, badgeCode])
  @@index([tenantId, status])
  @@index([unitId, status])
}

model JobTitle {
  id        String     @id @default(cuid())
  tenantId  String
  unitId    String?
  name      String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit      BusinessUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@index([unitId, active])
}

model Department {
  id         String     @id @default(cuid())
  tenantId   String
  unitId     String?
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit       BusinessUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  employees  Employee[]
  activities Activity[]

  @@unique([tenantId, name])
  @@index([unitId])
}

model Shift {
  id         String   @id @default(cuid())
  tenantId   String
  unitId     String?
  name       String
  startTime  String
  endTime    String
  toleranceMinutes Int @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit       BusinessUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  employees  Employee[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@index([unitId, active])
}

model Activity {
  id           String         @id @default(cuid())
  tenantId     String
  unitId       String?
  departmentId String?
  name         String
  code         String
  status       ActivityStatus @default(ACTIVE)
  targetPerHour Decimal?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         BusinessUnit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sessions     ActivitySession[]
  kioskDevices KioskDevice[]
  productionPunches ProductionPunch[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([unitId, status])
}

model ActivitySession {
  id               String        @id @default(cuid())
  tenantId         String
  unitId           String?
  employeeId       String
  activityId       String
  status           SessionStatus @default(RUNNING)
  startedAt        DateTime      @default(now())
  pausedAt         DateTime?
  endedAt          DateTime?
  productiveSeconds Int          @default(0)
  pausedSeconds     Int           @default(0)
  units             Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit               BusinessUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  activity           Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  punches            ProductionPunch[]

  @@index([tenantId, employeeId, status])
  @@index([tenantId, startedAt])
  @@index([unitId, startedAt])
}

model KioskDevice {
  id          String   @id @default(cuid())
  tenantId    String
  unitId      String?
  activityId  String
  name        String
  code        String
  secretHash  String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit        BusinessUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  punches     ProductionPunch[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@index([unitId, active])
}

model ProductionPunch {
  id            String              @id @default(cuid())
  tenantId      String
  unitId        String?
  employeeId    String
  kioskDeviceId String
  activityId    String
  sessionId     String
  type          ProductionPunchType
  sequence      Int
  recordedAt    DateTime            @default(now())
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit          BusinessUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kioskDevice   KioskDevice         @relation(fields: [kioskDeviceId], references: [id], onDelete: Cascade)
  activity      Activity            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  session       ActivitySession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([tenantId, employeeId, recordedAt])
  @@index([tenantId, kioskDeviceId, recordedAt])
  @@index([unitId, recordedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  unitId     String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit       BusinessUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([unitId, createdAt])
}
